#!/bin/sh
# Gradle wrapper script
# This script downloads and executes Gradle

# Find the project root
APP_HOME="$(cd "$(dirname "$0")" && pwd)"

# Use the wrapper properties to determine the Gradle distribution
WRAPPER_PROPERTIES="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

# Check if we have a local Gradle installation
if [ -f "$WRAPPER_PROPERTIES" ]; then
    # Extract distribution URL
    DISTRIBUTION_URL=$(grep "distributionUrl" "$WRAPPER_PROPERTIES" | cut -d'=' -f2 | tr -d '\\' | tr -d '\r')
    
    # Download Gradle if not exists
    GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
    GRADLE_VERSION=$(echo "$DISTRIBUTION_URL" | grep -oP 'gradle-\K[0-9.]+' || echo "7.6.3")
    GRADLE_HOME="$GRADLE_USER_HOME/wrapper/dists/gradle-${GRADLE_VERSION}-all"
    
    # Find the actual gradle installation
    if [ -d "$GRADLE_HOME" ]; then
        # Find the subdirectory
        for dir in "$GRADLE_HOME"/*/; do
            if [ -f "$dir/gradle-$GRADLE_VERSION/bin/gradle" ]; then
                GRADLE_EXE="$dir/gradle-$GRADLE_VERSION/bin/gradle"
                break
            fi
        done
    fi
fi

# Fallback to system gradle or download
if [ -z "$GRADLE_EXE" ] || [ ! -x "$GRADLE_EXE" ]; then
    # Try to find gradle in PATH
    if command -v gradle >/dev/null 2>&1; then
        GRADLE_EXE="$(command -v gradle)"
    else
        echo "Error: Gradle not found. Please install Gradle or run with Flutter."
        exit 1
    fi
fi

# Make sure gradle is executable
chmod +x "$GRADLE_EXE" 2>/dev/null || true

exec "$GRADLE_EXE" "$@"
